# ---- core ----
ENVIRONMENT=development            # development | production (controls cookie Secure flag, docs exposure)
DATABASE_URL=postgresql+asyncpg://kairo:kairo@db:5432/kairo

# ---- secrets (generate, do not reuse the examples) ----
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# ---- session ----
SESSION_TTL_DAYS=30

# ---- anilist oauth ----
# register at https://anilist.co/settings/developer
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URI=http://localhost:8000/auth/anilist/callback

# ---- llm ----
LLM_PROVIDER=openrouter            # openrouter | openai | anthropic | ollama
LLM_API_KEY=
# answer model - needs natural explanations (Claude Sonnet / GPT-4.1 / Gemini Pro class)
# example: anthropic/claude-3.5-sonnet
LLM_MODEL=
# gate/extraction model - cheap + fast, shallow json output (GPT-4.1-mini / Claude Haiku class)
# example: openai/gpt-4.1-mini
LLM_EXTRACTION_MODEL=
# only used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# ---- context / memory ----
MAX_CONTEXT_TOKENS=8000
HISTORY_MESSAGE_LIMIT=20
MAX_USER_MESSAGE_CHARS=2000

# ---- sync ----
SYNC_STALE_SECONDS=600

# ---- frontend / cors ----
FRONTEND_ORIGIN=http://localhost:3000
